# Optional — set these for real AI and Razorpay integration.
# Without them, the app uses rule-based fallback and dry-run mode.

# Gemini AI (for diagnosis and decision)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Razorpay (test mode only!)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# Database (defaults to SQLite if not set)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/revenue_recovery
