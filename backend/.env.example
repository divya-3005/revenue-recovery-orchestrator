DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/revenue_recovery # PostgreSQL connection string
RAZORPAY_KEY_ID= # Your Razorpay API Key ID for execution
RAZORPAY_KEY_SECRET= # Your Razorpay API Key Secret for execution
RAZORPAY_WEBHOOK_SECRET= # Webhook secret used to verify incoming events from Razorpay

# AI Configuration
AI_PRIMARY_PROVIDER=gemini # Primary AI provider (gemini, groq, or anthropic)
AI_FALLBACK_PROVIDER=groq # Fallback AI provider in case of primary failure
GEMINI_API_KEY= # Your Gemini API Key
GROQ_API_KEY= # Your Groq API Key
ANTHROPIC_API_KEY= # Your Anthropic API Key
GEMINI_MODEL_ID=gemini-2.5-flash # Model ID for Gemini (Default is active through Oct 2026)
GROQ_MODEL_ID=openai/gpt-oss-120b # Model ID for Groq (Recommended replacement for deprecated models)
ANTHROPIC_MODEL_ID=claude-sonnet-5 # Model ID for Anthropic (Current active model)

# Inngest Setup
INNGEST_EVENT_KEY= # Key to send events to Inngest in production
INNGEST_SIGNING_KEY= # Key to verify webhooks from Inngest in production
ENVIRONMENT= # Set to 'production' to enforce Inngest security keys
