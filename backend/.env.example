DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/revenue_recovery # PostgreSQL connection string
RAZORPAY_KEY_ID= # Your Razorpay API Key ID for execution
RAZORPAY_KEY_SECRET= # Your Razorpay API Key Secret for execution
RAZORPAY_WEBHOOK_SECRET= # Webhook secret used to verify incoming events from Razorpay
GEMINI_API_KEY= # Gemini API Key for primary AI diagnosis/decision
GROQ_API_KEY= # Groq API Key for fallback AI diagnosis/decision
INNGEST_EVENT_KEY= # Key to send events to Inngest in production
INNGEST_SIGNING_KEY= # Key to verify webhooks from Inngest in production
ENVIRONMENT= # Set to 'production' to enforce Inngest security keys
